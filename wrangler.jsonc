{
  // Cloudflare Workers config: serves ./public as a static website.
  "name": "gymblix-landing",
  "compatibility_date": "2026-05-01",
  // Only used for .mp4 files (adds byte-range support for Safari video).
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*.mp4"]
  }
}
